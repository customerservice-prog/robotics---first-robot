RIBITICS_NAME=Ribitics
RIBITICS_MODE=simulation
RIBITICS_SERIAL_PORT=/dev/ttyACM0
RIBITICS_SERIAL_BAUD=115200
RIBITICS_DATABASE_PATH=data/ribitics.db
RIBITICS_OLLAMA_URL=http://127.0.0.1:11434
RIBITICS_OLLAMA_MODEL=qwen2.5:3b

# Robot speaker output
RIBITICS_ENABLE_LOCAL_TTS=false
RIBITICS_TTS_COMMAND=espeak-ng

# Robot-side always-listening microphone. Set true after installing the Vosk model.
RIBITICS_ENABLE_VOICE_LOOP=false
RIBITICS_VOICE_ENGINE=vosk
RIBITICS_WAKE_PHRASE=hey ribitics
RIBITICS_VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
RIBITICS_MICROPHONE_DEVICE=
RIBITICS_VOICE_SAMPLE_RATE=16000
RIBITICS_VOICE_BLOCK_SIZE=4000
RIBITICS_VOICE_COMMAND_TIMEOUT_SECONDS=8

# Optional local USB camera.
RIBITICS_ENABLE_CAMERA=false
RIBITICS_CAMERA_DEVICE=0
RIBITICS_CAMERA_WIDTH=640
RIBITICS_CAMERA_HEIGHT=480
RIBITICS_CAMERA_FPS=12
RIBITICS_CAMERA_JPEG_QUALITY=80
RIBITICS_CAMERA_MOTION_THRESHOLD=12

# Optional 2D LiDAR on the main robot computer.
RIBITICS_ENABLE_LIDAR=false
RIBITICS_LIDAR_MODEL=RPLIDAR-A1
RIBITICS_LIDAR_PORT=/dev/ttyUSB0
RIBITICS_LIDAR_FORWARD_ANGLE_DEG=0
RIBITICS_LIDAR_FRONT_ARC_DEG=35
RIBITICS_LIDAR_MAX_DISTANCE_MM=6000

# Supplemental obstacle gate. Physical E-stop remains mandatory.
RIBITICS_OBSTACLE_STOP_CM=35
RIBITICS_OBSTACLE_WARN_CM=70
RIBITICS_REQUIRE_PROXIMITY_FOR_FORWARD=false

# Encoder dead-reckoning. The defaults are development placeholders.
# Measure the actual wheel diameter, wheel-center spacing and signed ticks per wheel revolution.
RIBITICS_ENABLE_ODOMETRY=true
RIBITICS_ODOMETRY_CALIBRATED=false
RIBITICS_WHEEL_DIAMETER_CM=6.5
RIBITICS_WHEEL_BASE_CM=15.0
RIBITICS_ENCODER_TICKS_PER_REVOLUTION=360
RIBITICS_ODOMETRY_POLL_HZ=20
RIBITICS_ODOMETRY_STALE_SECONDS=1
RIBITICS_SIMULATION_ENCODER_TICKS_PER_SECOND=360

# Local occupancy map from LiDAR + odometry.
RIBITICS_ENABLE_MAPPING=true
RIBITICS_MAP_RESOLUTION_CM=5
RIBITICS_MAP_SIZE_CM=1200
RIBITICS_MAP_ROBOT_RADIUS_CM=20
RIBITICS_MAPPING_POLL_HZ=5
RIBITICS_MAP_PERSISTENCE_PATH=data/ribitics-map.json
RIBITICS_MAP_AUTO_LOAD=false
RIBITICS_MAP_AUTO_SAVE=false

# Bounded LiDAR scan matching against a frozen reference map.
# A live map that is still learning is never trusted as a localization reference.
RIBITICS_ENABLE_LOCALIZATION=true
RIBITICS_LOCALIZATION_POLL_HZ=2
RIBITICS_LOCALIZATION_SEARCH_XY_CM=30
RIBITICS_LOCALIZATION_SEARCH_HEADING_DEG=12
RIBITICS_LOCALIZATION_XY_STEP_CM=5
RIBITICS_LOCALIZATION_HEADING_STEP_DEG=3
RIBITICS_LOCALIZATION_MIN_POINTS=25
RIBITICS_LOCALIZATION_MIN_CONFIDENCE=0.45
RIBITICS_LOCALIZATION_NAV_MIN_CONFIDENCE=0.55
RIBITICS_LOCALIZATION_MAX_CORRECTION_CM=35
RIBITICS_LOCALIZATION_MAX_CORRECTION_DEG=15
RIBITICS_LOCALIZATION_CONFIDENCE_DECAY_DISTANCE_CM=250
RIBITICS_LOCALIZATION_CONFIDENCE_DECAY_SECONDS=20

# Persistent rotation-aware LiDAR place anchors.
# Recognition proposes a pose hint only; geometric scan matching must verify it.
RIBITICS_ENABLE_PLACE_RECOGNITION=true
RIBITICS_PLACE_ANCHOR_PATH=data/ribitics-places.json
RIBITICS_PLACE_DESCRIPTOR_SECTORS=36
RIBITICS_PLACE_DESCRIPTOR_MAX_RANGE_CM=600
RIBITICS_PLACE_MIN_VALID_SECTORS=10
RIBITICS_PLACE_MIN_SIMILARITY=0.72
RIBITICS_PLACE_MIN_MARGIN=0.04
RIBITICS_PLACE_MAX_ANCHORS=100
RIBITICS_PLACE_VERIFY_SEARCH_XY_CM=100
RIBITICS_PLACE_VERIFY_SEARCH_HEADING_DEG=35

# Physical navigation is intentionally locked by default.
# Only enable after encoder calibration, LiDAR, map, E-stop and braking tests are complete.
RIBITICS_ENABLE_SUPERVISED_NAVIGATION=false
RIBITICS_NAVIGATION_ALLOW_UNKNOWN=false
RIBITICS_NAVIGATION_MAX_GOAL_DISTANCE_CM=500
RIBITICS_NAVIGATION_MAX_LINEAR=0.22
RIBITICS_NAVIGATION_MAX_ANGULAR=0.28
RIBITICS_NAVIGATION_WAYPOINT_TOLERANCE_CM=12
RIBITICS_NAVIGATION_HEADING_TOLERANCE_DEG=12
RIBITICS_NAVIGATION_TIMEOUT_SECONDS=120

# Persistent dock approach tied to the current map UUID.
# Final charging contact is still manual until close-range alignment/contact hardware exists.
RIBITICS_DOCK_APPROACH_DISTANCE_CM=60
RIBITICS_DOCK_PERSISTENCE_PATH=data/ribitics-dock.json
RIBITICS_DOCK_AUTO_LOAD=false

RIBITICS_MAX_MOTOR_PERCENT=65
RIBITICS_CONTROL_TOKEN=change-me-before-network-use
